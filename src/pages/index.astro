---
import Layout from '../layouts/Layout.astro';

// 文章列表（可以改成从文件读取，或者用 content collections）
const posts = [
  {
    title: '无服务器搭建博客指南',
    slug: 'serverless-blog-guide',
    date: '2026-08-10',
    desc: '用 Cloudflare 全家桶零成本搭建个人博客，带你从零到上线。',
  },
  {
    title: 'Hello World',
    slug: 'hello-world',
    date: '2026-08-09',
    desc: '第一篇博客，随便写点什么。',
  },
];
---

<Layout title="熊的窝">
  <h1>📝 最近的文章</h1>

  <div style="margin-top: 2rem;">
    {posts.map(post => (
      <article style="
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: transform 0.2s;
      ">
        <a href={`/posts/${post.slug}`} style="text-decoration: none; color: var(--text);">
          <h2 style="margin: 0 0 0.5rem;">{post.title}</h2>
        </a>
        <div class="post-meta">{post.date}</div>
        <p>{post.desc}</p>
        <a href={`/posts/${post.slug}`}>阅读更多 →</a>
      </article>
    ))}
  </div>
</Layout>