---
import Layout from '../layouts/Layout.astro';
---

<Layout title="后台管理">
  <div id="app">
    <!-- 登录界面 -->
    <div id="login-view" style="max-width: 400px; margin: 4rem auto; text-align: center;">
      <h1>🔐 博客后台管理</h1>
      <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
        <input id="login-user" placeholder="用户名" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;" />
        <input id="login-pass" type="password" placeholder="密码" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;" />
        <button onclick="login()" style="padding: 0.75rem; background: var(--accent); color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer;">登录</button>
        <p id="login-msg" style="color: var(--accent);"></p>
      </div>
    </div>

    <!-- 管理界面 -->
    <div id="admin-view" style="display: none;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>📊 博客后台</h1>
        <button onclick="logout()" style="padding: 0.5rem 1rem; background: #666; color: white; border: none; border-radius: 6px; cursor: pointer;">退出</button>
      </div>

      <!-- 统计卡片 -->
      <div id="stats-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem;"></div>

      <!-- 导航 tabs -->
      <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
        <button class="tab active" data-tab="posts" onclick="showTab('posts')">📝 文章</button>
        <button class="tab" data-tab="newpost" onclick="showTab('newpost')">✏️ 写文章</button>
        <button class="tab" data-tab="comments" onclick="showTab('comments')">💬 评论</button>
        <button class="tab" data-tab="theme" onclick="showTab('theme')">🎨 主题</button>
        <button class="tab" data-tab="stats" onclick="showTab('stats')">📈 统计</button>
      </div>

      <!-- 文章列表 -->
      <div id="tab-posts" class="tab-content">
        <div id="posts-list"></div>
      </div>

      <!-- 写文章 -->
      <div id="tab-newpost" class="tab-content" style="display: none;">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <input id="post-title" placeholder="文章标题 *" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1.1rem;" />
          <input id="post-slug" placeholder="slug（URL 标识，如 my-first-post）*" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;" />
          <textarea id="post-excerpt" placeholder="摘要（可选）" rows="2" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;"></textarea>
          <textarea id="post-content" placeholder="文章内容（支持 HTML）*" rows="12" style="padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem; font-family: monospace;"></textarea>
          <button onclick="createPost()" style="padding: 0.75rem; background: var(--accent); color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer; align-self: flex-start;">发布文章</button>
          <p id="post-msg" style="color: var(--accent);"></p>
        </div>
      </div>

      <!-- 评论管理 -->
      <div id="tab-comments" class="tab-content" style="display: none;">
        <div id="comments-admin-list"></div>
      </div>

      <!-- 主题设置 -->
      <div id="tab-theme" class="tab-content" style="display: none;">
        <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 400px;">
          <div>
            <label>主色调</label>
            <input id="theme-color" type="color" style="width: 100%; height: 40px; border: none; border-radius: 8px; cursor: pointer;" />
          </div>
          <div>
            <label>背景色</label>
            <input id="theme-bg" type="color" style="width: 100%; height: 40px; border: none; border-radius: 8px; cursor: pointer;" />
          </div>
          <div>
            <label>站点标题</label>
            <input id="theme-title" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;" />
          </div>
          <div>
            <label>站点副标题</label>
            <input id="theme-subtitle" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem;" />
          </div>
          <button onclick="saveTheme()" style="padding: 0.75rem; background: var(--accent); color: white; border: none; border-radius: 8px; font-size: 1rem; cursor: pointer;">保存主题</button>
          <p id="theme-msg" style="color: var(--accent);"></p>
        </div>
      </div>

      <!-- 统计详情 -->
      <div id="tab-stats" class="tab-content" style="display: none;">
        <div id="stats-detail"></div>
      </div>
    </div>
  </div>

  <style>
    .tab { padding: 0.6rem 1.2rem; border: 1px solid var(--border); background: var(--card-bg); border-radius: 8px; cursor: pointer; font-size: 0.95rem; }
    .tab.active { background: var(--accent); color: white; border-color: var(--accent); }
    .stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; text-align: center; }
    .stat-card .num { font-size: 1.6rem; font-weight: 700; color: var(--accent); }
    .stat-card .label { font-size: 0.8rem; color: var(--muted); }
    .post-item { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; }
    .comment-item { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; }
    .btn { padding: 0.4rem 0.8rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; margin-left: 0.4rem; }
    .btn-danger { background: #e94560; color: white; }
    .btn-edit { background: #4caf50; color: white; }
    label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.3rem; }
  </style>

  <script>
    const API = 'https://my-blog-api.ostwaltamy.workers.dev/api';
    let token = localStorage.getItem('blog_token') || '';

    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
    }

    async function api(path, opts = {}) {
      const res = await fetch(API + path, { ...opts, headers: { ...authHeaders(), ...(opts.headers || {}) } });
      return await res.json();
    }

    // 登录
    async function login() {
      const username = document.getElementById('login-user').value;
      const password = document.getElementById('login-pass').value;
      const data = await api('/admin/login', { method: 'POST', body: JSON.stringify({ username, password }) });
      if (data.success) {
        token = data.token;
        localStorage.setItem('blog_token', token);
        document.getElementById('login-view').style.display = 'none';
        document.getElementById('admin-view').style.display = 'block';
        loadAll();
      } else {
        document.getElementById('login-msg').textContent = data.error || '登录失败';
      }
    }

    function logout() {
      token = '';
      localStorage.removeItem('blog_token');
      location.reload();
    }

    // 加载所有数据
    async function loadAll() {
      if (!token) return;
      loadStats();
      loadPosts();
      loadAdminComments();
      loadTheme();
    }

    // 统计卡片
    async function loadStats() {
      const data = await api('/admin/stats');
      if (!data.stats) return;
      const s = data.stats;
      const cards = [
        { num: s.totalViews, label: '总浏览量' },
        { num: s.todayViews, label: '今日' },
        { num: s.totalPosts, label: '文章' },
        { num: s.totalComments, label: '评论' },
      ];
      document.getElementById('stats-row').innerHTML = cards.map(c =>
        '<div class="stat-card"><div class="num">' + c.num + '</div><div class="label">' + c.label + '</div></div>'
      ).join('');
    }

    // 文章列表
    async function loadPosts() {
      const data = await api('/admin/posts').catch(() => ({ posts: [] }));
      const posts = data.posts || [];
      document.getElementById('posts-list').innerHTML = posts.length ? posts.map(p =>
        '<div class="post-item"><div><strong>' + p.title + '</strong><div style="color: var(--muted); font-size: 0.8rem;">' + p.slug + ' · ' + (p.created_at || '') + '</div></div>' +
        '<div><button class="btn btn-danger" onclick="deletePost(' + p.id + ')">删除</button></div></div>'
      ).join('') : '<p style="color: var(--muted);">还没有文章</p>';
    }

    // 写文章
    async function createPost() {
      const title = document.getElementById('post-title').value.trim();
      const slug = document.getElementById('post-slug').value.trim();
      const content = document.getElementById('post-content').value.trim();
      const excerpt = document.getElementById('post-excerpt').value.trim();
      const msg = document.getElementById('post-msg');
      if (!title || !slug || !content) { msg.textContent = '标题、slug、内容必填'; msg.style.color = 'var(--accent)'; return; }
      const data = await api('/admin/posts', { method: 'POST', body: JSON.stringify({ title, slug, content, excerpt }) });
      if (data.success) {
        msg.textContent = '发布成功！地址: /posts/' + slug;
        msg.style.color = '#4caf50';
        document.getElementById('post-title').value = '';
        document.getElementById('post-slug').value = '';
        document.getElementById('post-content').value = '';
        document.getElementById('post-excerpt').value = '';
        loadPosts(); loadStats();
      } else {
        msg.textContent = data.error || '发布失败';
        msg.style.color = 'var(--accent)';
      }
    }

    async function deletePost(id) {
      if (!confirm('确定删除这篇文章？')) return;
      await api('/admin/posts/' + id, { method: 'DELETE' });
      loadPosts(); loadStats();
    }

    // 评论管理
    async function loadAdminComments() {
      const data = await api('/admin/comments').catch(() => ({ comments: [] }));
      const comments = data.comments || [];
      document.getElementById('comments-admin-list').innerHTML = comments.length ? comments.map(c =>
        '<div class="comment-item"><strong>' + c.author + '</strong> <span style="color: var(--muted); font-size: 0.8rem;">on ' + c.post_slug + ' · ' + c.created_at + '</span>' +
        '<p>' + c.content + '</p><button class="btn btn-danger" onclick="deleteComment(' + c.id + ')">删除</button></div>'
      ).join('') : '<p style="color: var(--muted);">还没有评论</p>';
    }

    async function deleteComment(id) {
      if (!confirm('确定删除这条评论？')) return;
      await api('/admin/comments/' + id, { method: 'DELETE' });
      loadAdminComments(); loadStats();
    }

    // 主题
    async function loadTheme() {
      const data = await api('/settings').catch(() => ({ settings: {} }));
      const s = data.settings || {};
      document.getElementById('theme-color').value = s.theme_primary_color || '#e94560';
      document.getElementById('theme-bg').value = s.theme_bg_color || '#fafafa';
      document.getElementById('theme-title').value = s.blog_title || '熊的窝';
      document.getElementById('theme-subtitle').value = s.blog_subtitle || '';
    }

    async function saveTheme() {
      const msg = document.getElementById('theme-msg');
      const data = await api('/admin/settings', {
        method: 'PUT',
        body: JSON.stringify({
          theme_primary_color: document.getElementById('theme-color').value,
          theme_bg_color: document.getElementById('theme-bg').value,
          blog_title: document.getElementById('theme-title').value,
          blog_subtitle: document.getElementById('theme-subtitle').value,
        })
      });
      if (data.success) {
        msg.textContent = '主题已保存！';
        msg.style.color = '#4caf50';
        document.documentElement.style.setProperty('--accent', document.getElementById('theme-color').value);
        document.documentElement.style.setProperty('--bg', document.getElementById('theme-bg').value);
      } else {
        msg.textContent = data.error || '保存失败';
        msg.style.color = 'var(--accent)';
      }
    }

    // 统计详情
    async function loadStatsDetail() {
      const data = await api('/admin/stats');
      if (!data.stats) return;
      const s = data.stats;
      let html = '<h3>📈 详细统计</h3>';
      html += '<p><strong>总浏览量:</strong> ' + s.totalViews + '</p>';
      html += '<p><strong>今日浏览量:</strong> ' + s.todayViews + '</p>';
      html += '<h4>热门页面 TOP10</h4><ul>';
      (s.topPages || []).forEach(p => { html += '<li>' + p.path + ' — ' + p.t + ' 次</li>'; });
      html += '</ul>';
      html += '<h4>近 7 天趋势</h4><ul>';
      (s.weekly || []).forEach(w => { html += '<li>' + w.date + ' — ' + w.t + ' 次</li>'; });
      html += '</ul>';
      document.getElementById('stats-detail').innerHTML = html;
    }

    // Tab 切换
    function showTab(name) {
      document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
      document.getElementById('tab-' + name).style.display = 'block';
      document.querySelector('.tab[data-tab="' + name + '"]').classList.add('active');
      if (name === 'stats') loadStatsDetail();
      if (name === 'posts') loadPosts();
      if (name === 'comments') loadAdminComments();
      if (name === 'theme') loadTheme();
    }

    // 自动登录
    async function init() {
      if (token) {
        try {
          const data = await api('/admin/stats');
          if (data.stats) {
            document.getElementById('login-view').style.display = 'none';
            document.getElementById('admin-view').style.display = 'block';
            loadAll();
          }
        } catch (e) { localStorage.removeItem('blog_token'); }
      }
    }
    init();
  </script>
</Layout>