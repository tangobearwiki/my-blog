---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { slug: 'serverless-blog-guide' } },
    { params: { slug: 'hello-world' } },
  ];
}

const { slug } = Astro.params;

const posts = {
  'serverless-blog-guide': {
    title: '无服务器搭建博客指南',
    date: '2026-08-10',
    content: `
      <p>这篇文章教你如何用 Cloudflare 全家桶零成本搭建个人博客。</p>
      <p>前端用 Astro 生成静态页面，后端用 Cloudflare Workers 提供 API，数据用 D1 数据库存储。</p>
      <p>整套方案完全免费，不需要自己管服务器，只要有一台能写代码的电脑就行。</p>
      <h2>你需要准备什么</h2>
      <ul>
        <li>一个 GitHub 账号</li>
        <li>一个 Cloudflare 账号</li>
        <li>Node.js 环境（本地开发用）</li>
        <li>一个域名（可选，也可以用 Cloudflare 提供的免费子域名）</li>
      </ul>
      <h2>整体架构</h2>
      <p>Cloudflare Pages 托管前端静态文件，Workers 处理评论 API，D1 存评论数据。</p>
      <p>所有服务都在 Cloudflare 的全球边缘网络上运行。</p>
    `,
  },
  'hello-world': {
    title: 'Hello World',
    date: '2026-08-09',
    content: `
      <p>第一篇博客，你好世界！</p>
      <p>这只是一个开始，以后会在这里分享技术笔记和生活记录。</p>
    `,
  },
};

const post = posts[slug];
---

<Layout title={post.title}>
  <article>
    <h1>{post.title}</h1>
    <div class="post-meta">{post.date}</div>
    <hr />
    <div set:html={post.content}></div>
  </article>

  <hr />

  <div id="comments-section">
    <h2>评论</h2>
    <div id="comments-list"></div>

    <form id="comment-form" style="margin-top: 1.5rem;">
      <h3>发表评论</h3>
      <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
        <input type="text" id="author" placeholder="你的名字 *" required style="padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem;" />
        <input type="email" id="email" placeholder="邮箱（不会被公开）" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem;" />
        <textarea id="content" placeholder="说点什么吧... *" required rows="4" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; resize: vertical;"></textarea>
        <button type="submit" style="padding: 0.6rem 1.5rem; background: var(--accent); color: white; border: none; border-radius: 6px; font-size: 1rem; cursor: pointer; align-self: flex-start;">提交评论</button>
        <p id="form-status" style="font-size: 0.875rem; color: var(--muted);"></p>
      </div>
    </form>
  </div>

  <script>
    const API_BASE = '';
    const slug = window.location.pathname.split('/').pop();

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    async function loadComments() {
      const list = document.getElementById('comments-list');
      list.innerHTML = '<p>加载中...</p>';

      try {
        const res = await fetch(API_BASE + '/api/comments?slug=' + slug);
        const data = await res.json();

        if (data.comments && data.comments.length > 0) {
          list.innerHTML = data.comments.map(function(c) {
            return '<div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">' +
              '<strong>' + escapeHtml(c.author) + '</strong>' +
              '<span style="color: var(--muted); font-size: 0.8rem; margin-left: 0.5rem;">' + new Date(c.created_at).toLocaleDateString('zh-CN') + '</span>' +
              '<p style="margin-top: 0.5rem;">' + escapeHtml(c.content) + '</p>' +
              '</div>';
          }).join('');
        } else {
          list.innerHTML = '<p style="color: var(--muted);">还没有评论，快来抢沙发吧</p>';
        }
      } catch (err) {
        list.innerHTML = '<p>加载评论失败，请稍后重试</p>';
      }
    }

    document.getElementById('comment-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const status = document.getElementById('form-status');
      const author = document.getElementById('author').value.trim();
      const content = document.getElementById('content').value.trim();
      const email = document.getElementById('email').value.trim();

      if (!author || !content) {
        status.textContent = '请填写名字和评论内容';
        return;
      }

      status.textContent = '提交中...';
      status.style.color = 'var(--muted)';

      try {
        const res = await fetch(API_BASE + '/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug, author: author, content: content, email: email || undefined }),
        });

        const data = await res.json();

        if (data.success) {
          status.textContent = '评论提交成功！';
          status.style.color = '#4caf50';
          document.getElementById('author').value = '';
          document.getElementById('content').value = '';
          document.getElementById('email').value = '';
          loadComments();
        } else {
          status.textContent = data.error || '提交失败，请重试';
          status.style.color = '#e94560';
        }
      } catch (err) {
        status.textContent = '网络错误，请稍后重试';
        status.style.color = '#e94560';
      }
    });

    loadComments();
  </script>
</Layout>